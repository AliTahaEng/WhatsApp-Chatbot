# WhatsApp AutoGen Bot Configuration

# =====================================================
# API KEYS - Azure OpenAI (GPT-4)
# =====================================================
AZURE_OPENAI_ENDPOINT=https://optimusrcm.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_KEY=ddc8a85d76dd4b40a1b4cab60430b1b5
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_RESOURCE_NAME=optimusrcm
# Get your Azure OpenAI credentials from: https://portal.azure.com/

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DATABASE_PATH=./data/database.db
DATABASE_BACKUP_PATH=./data/backups/

# =====================================================
# WHATSAPP CONFIGURATION
# =====================================================
WHATSAPP_SESSION_PATH=./data/session
WHATSAPP_MEDIA_PATH=./data/media

# =====================================================
# ADMIN CONFIGURATION
# =====================================================
ADMIN_WHATSAPP_ID=1234567890@c.us
ADMIN_COMMANDS_ENABLED=true
ADMIN_PREFIX=/admin

# =====================================================
# SECURITY CONFIGURATION
# =====================================================
SESSION_SECRET=your_random_session_secret_here_min_32_chars
ENCRYPTION_KEY=your_base64_encryption_key_here
JWT_SECRET=your_jwt_secret_here

# =====================================================
# RATE LIMITING CONFIGURATION
# =====================================================
RATE_LIMIT_ENABLED=true
MAX_MESSAGES_PER_MINUTE=5
MAX_MESSAGES_PER_HOUR=50
MAX_MESSAGES_PER_DAY=200
MAX_TOKENS_PER_CONTACT=10000
MAX_TOKENS_PER_DAY=50000

# =====================================================
# BUSINESS HOURS CONFIGURATION
# =====================================================
BUSINESS_HOURS_ENABLED=false
BUSINESS_TIMEZONE=America/New_York
BUSINESS_START_TIME=09:00
BUSINESS_END_TIME=17:00

# =====================================================
# AGENT CONFIGURATION
# =====================================================
CUSTOMER_SUPPORT_ENABLED=true
TECH_SUPPORT_ENABLED=true
RESEARCH_AGENT_ENABLED=true
SCHEDULER_AGENT_ENABLED=true

# =====================================================
# LOGGING CONFIGURATION
# =====================================================
LOG_LEVEL=info
LOG_FILE=./data/logs/app.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5

# =====================================================
# PERFORMANCE CONFIGURATION
# =====================================================
MAX_CONVERSATION_HISTORY=10
RESPONSE_TIMEOUT=30000
PYTHON_PROCESS_COUNT=1
ENABLE_CACHING=true
CACHE_TTL_MINUTES=30

# =====================================================
# FEATURES CONFIGURATION
# =====================================================
ENABLE_WEB_SEARCH=false
ENABLE_MEDIA_PROCESSING=false
ENABLE_GROUP_CHATS=false
ENABLE_VOICE_MESSAGES=false
ENABLE_NOTIFICATIONS=true

# =====================================================
# ADMIN AUTHENTICATION CONFIGURATION
# =====================================================
ADMIN_SESSION_SECRET=your-secure-session-secret-here-min-32-chars
ADMIN_SESSION_DURATION=24
LOGIN_RATE_LIMIT_WINDOW=15
LOGIN_RATE_LIMIT_MAX=10
ACCOUNT_LOCKOUT_DURATION=15
ACCOUNT_LOCKOUT_ATTEMPTS=5
SESSION_CLEANUP_INTERVAL=60

# =====================================================
# TWO-FACTOR AUTHENTICATION
# =====================================================
TWO_FACTOR_ISSUER=WhatsApp AutoGen Bot
TWO_FACTOR_WINDOW=2
ENCRYPTION_KEY=your-32-character-encryption-key-here

# =====================================================
# ADMIN NOTIFICATIONS CONFIGURATION
# =====================================================
ADMIN_NOTIFICATIONS_ENABLED=true
OWNER_WHATSAPP_ID=1234567890@c.us
DAILY_REPORT_TIME=20:00
WEEKLY_REPORT_DAY=sunday
HIGH_VOLUME_THRESHOLD=100
ERROR_NOTIFICATION_LIMIT=5
SPAM_NOTIFICATION_LIMIT=3

# =====================================================
# WEB DASHBOARD CONFIGURATION
# =====================================================
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_CORS_ORIGIN=*
PYTHON_LOG_CONSOLE=true
PYTHON_LOG_FILE=./data/logs/python.log

# =====================================================
# DEFAULT ADMIN USER (CHANGE IN PRODUCTION)
# =====================================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password-immediately
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com

# =====================================================
# DEVELOPMENT CONFIGURATION
# =====================================================
NODE_ENV=development
DEBUG_ENABLED=false
MOCK_WHATSAPP=false
MOCK_CLAUDE_API=false
